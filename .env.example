# Copy to .env for local development. Never commit real production secrets.
POSTGRES_DB=reality_test
POSTGRES_USER=reality
POSTGRES_PASSWORD=replace-me
REALITY_DATABASE_URL=postgresql+psycopg://reality:replace-me@db:5432/reality_test
# Required in production. Generate a Fernet key once and keep it outside the database.
# Existing encrypted credentials become unreadable if this key is lost or changed.
REALITY_MASTER_KEY=

# Server-only credential for the managed internal Copilot. Never expose it to browser builds.
ANTHROPIC_API_KEY=
# Required only for identity-linked Anthropic API keys; omit for standard workspace keys.
ANTHROPIC_WORKSPACE_ID=

MINIO_ROOT_USER=reality
MINIO_ROOT_PASSWORD=replace-me
REALITY_S3_BUCKET=reality-artifacts
REALITY_S3_REGION=eu-central-1

# Local development URLs used by `make dev`. Deployment URLs belong in the
# deployment platform's environment configuration, not in repository env files.
# Link target only; no site container is served from this repository.
SITE_URL=http://localhost:8082
APP_URL=http://localhost:8080
API_URL=http://localhost:8000
MCP_URL=http://localhost:8001/
DOCS_URL=http://localhost:8083
# Host ports are independent from public URLs and can be overridden for Compose.
APP_PORT=8080
API_PORT=8000
MCP_PORT=8001
DOCS_PORT=8083
# These values control only the internal MCP listener.
MCP_BIND_HOST=0.0.0.0
MCP_BIND_PORT=8001

# Bounded PostgreSQL pools. With the defaults, Backend can open at most 15
# connections and MCP at most 7, for a combined application ceiling of 22.
# Reserve additional database capacity for migrations, workers, and operators.
REALITY_BACKEND_DB_POOL_SIZE=10
REALITY_BACKEND_DB_MAX_OVERFLOW=5
REALITY_MCP_DB_POOL_SIZE=5
REALITY_MCP_DB_MAX_OVERFLOW=2
REALITY_DB_POOL_TIMEOUT=5
# Leave empty in production when tenants are created through onboarding.
REALITY_BOOTSTRAP_TENANT_NAME=Acme Bikes GmbH

# Transactional email. Use onboarding@resend.dev only for initial testing;
# production senders must use a domain verified in Resend.
REALITY_EMAIL_PROVIDER=resend
RESEND_API_KEY=
REALITY_EMAIL_FROM=Reality <reality@example.com>
REALITY_ACCESS_NOTIFICATION_EMAIL=
REALITY_AUTO_APPROVE_LIMIT=100
REALITY_CLOUD_PRICE_EUR=49
