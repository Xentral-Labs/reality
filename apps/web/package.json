{
  "name": "reality-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite --config vite.config.ts build",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:i18n": "node --test scripts/*.test.mjs",
    "test:contracts": "node --test scripts/*.test.mjs",
    "test:unified-browser": "node scripts/unified-app-browser.mjs && node scripts/unified-delivery-browser.mjs",
    "test:workspace-browser": "node scripts/unified-workspaces-browser.mjs",
    "test:orders-browser": "node scripts/unified-orders-browser.mjs",
    "test:settings-browser": "node scripts/unified-settings-browser.mjs",
    "test:sources-browser": "node scripts/unified-sources-browser.mjs",
    "test:finance-browser": "node scripts/unified-finance-browser.mjs",
    "test:operations-browser": "node scripts/unified-operations-browser.mjs",
    "test:facts-browser": "node scripts/unified-facts-browser.mjs",
    "test:tables-browser": "node scripts/unified-tables-browser.mjs",
    "test:receipt-release-browser": "node scripts/unified-receipt-release-browser.mjs",
    "test:holds-browser": "node scripts/unified-holds-browser.mjs",
    "test:corrections-browser": "node scripts/unified-corrections-browser.mjs",
    "test:order-entry-browser": "node scripts/unified-order-entry-browser.mjs",
    "test:invoice-entry-browser": "node scripts/unified-invoice-entry-browser.mjs",
    "test:payment-entry-browser": "node scripts/unified-payment-entry-browser.mjs",
    "test:financial-reversal-browser": "node scripts/unified-financial-reversal-browser.mjs",
    "test:credit-entry-browser": "node scripts/unified-credit-entry-browser.mjs",
    "test:refund-entry-browser": "node scripts/unified-refund-entry-browser.mjs",
    "test:business-journey": "cd ../../packages/reality-core && PYTHONPATH=src ../../.venv/bin/pytest -q -s tests/browser/unified_business_journey.py",
    "test:company-access-browser": "node scripts/unified-company-access-browser.mjs",
    "test:item-import-browser": "cd ../../packages/reality-core && PYTHONPATH=src ../../.venv/bin/pytest -q -s tests/browser/unified_item_csv_import.py",
    "test:source-configuration-browser": "node scripts/unified-source-configuration-browser.mjs",
    "test:ai-access-browser": "node scripts/unified-ai-access-browser.mjs",
    "test:opening-stock-browser": "node scripts/unified-opening-stock-browser.mjs",
    "test:customer-holds-browser": "node scripts/unified-customer-holds-browser.mjs",
    "test:activity-browser": "node scripts/unified-activity-browser.mjs",
    "test:shell-chat-browser": "node scripts/unified-shell-chat-browser.mjs",
    "test:chat-composer-browser": "node scripts/unified-chat-composer-browser.mjs",
    "test:inspector-browser": "node scripts/unified-inspector-browser.mjs",
    "test:retirement-browser": "node scripts/retirement-browser.mjs",
    "test:storyline-browser": "node scripts/storyline-browser.mjs",
    "test:integrations-browser": "node scripts/integrations-catalog-browser.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.29.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3"
  }
}
