{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reality Local Development",
  "version": "0.1.0",
  "identifier": "ai.runreality.local.development",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/RealityLocal.icns"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
