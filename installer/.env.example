# Reality self-hosted configuration. install.sh writes this file with generated
# values; edit only what you understand. Never commit it.

# Which release runs. `install.sh upgrade` rewrites this line.
REALITY_VERSION=0.1.0
# Where the images come from. Only change for a mirror or a local build.
REALITY_IMAGE_REGISTRY=ghcr.io/xentral-labs
COMPOSE_PROJECT_NAME=reality

# Mode. Direct: one host port. Domain: Caddy on 80/443 with HTTPS.
#   COMPOSE_FILE=compose.yml:compose.direct.yml
#   COMPOSE_FILE=compose.yml:compose.proxy.yml
# Append :compose.s3.yml to store source binaries in MinIO instead of a volume.
COMPOSE_FILE=compose.yml:compose.direct.yml
REALITY_BIND=0.0.0.0
REALITY_PORT=8080
REALITY_MCP_PORT=8001
REALITY_DOMAIN=

# Public origins. Direct mode uses localhost; domain mode uses https://<domain>
# and https://mcp.<domain>/ (MCP keeps the origin root, never a path).
APP_URL=http://localhost:8080
MCP_URL=http://localhost:8001/
REALITY_COOKIE_SECURE=false
# "production" only together with a domain: MCP then insists on HTTPS.
REALITY_MCP_ENV=

# PostgreSQL. Generated; the database lives in the postgres_data volume.
POSTGRES_DB=reality
POSTGRES_USER=reality
POSTGRES_PASSWORD=generated

# Encryption key for stored credentials. Generated once. Losing it makes every
# encrypted credential unreadable; it is part of every backup archive.
REALITY_MASTER_KEY=generated

# First owner. Generated password, printed once by the installer.
REALITY_PLATFORM_ADMIN_EMAIL=owner@reality.local
REALITY_PLATFORM_ADMIN_PASSWORD=generated
REALITY_AUTO_APPROVE_LIMIT=0

# Optional: transactional email for invitations (resend or smtp).
REALITY_EMAIL_PROVIDER=
REALITY_EMAIL_FROM=
RESEND_API_KEY=
REALITY_SMTP_HOST=
REALITY_SMTP_PORT=587
REALITY_SMTP_TLS=true
REALITY_SMTP_USERNAME=
REALITY_SMTP_PASSWORD=

# Optional: internal Copilot. The product runs without it.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Optional: MinIO values, used only with compose.s3.yml.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
REALITY_S3_BUCKET=reality-artifacts
REALITY_S3_REGION=eu-central-1
