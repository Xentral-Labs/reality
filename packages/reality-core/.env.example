REALITY_DATABASE_URL=postgresql+psycopg://reality:password@localhost:54329/reality
# Required in production. Generate a Fernet key once and keep it outside the database.
# Existing encrypted credentials become unreadable if this key is lost or changed.
REALITY_MASTER_KEY=

# Immutable source binaries. Use file locally and S3-compatible storage in production.
REALITY_ARTIFACT_STORAGE=file
REALITY_ARTIFACT_DIR=data/artifacts
# REALITY_ARTIFACT_STORAGE=s3
# REALITY_S3_ENDPOINT_URL=http://localhost:9000  # omit for AWS S3
# REALITY_S3_BUCKET=reality-artifacts
# REALITY_S3_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
REALITY_AUTH_MODE=enabled
REALITY_COOKIE_SECURE=false
REALITY_AUTH_EXPOSE_CODES=false
REALITY_PLATFORM_ADMIN_EMAIL=owner@example.com
REALITY_PLATFORM_ADMIN_PASSWORD=replace-with-a-long-random-password
REALITY_PUBLIC_APP_URL=http://localhost:8080/app
REALITY_SMTP_HOST=
REALITY_SMTP_PORT=587
REALITY_SMTP_TLS=true
REALITY_SMTP_USERNAME=
REALITY_SMTP_PASSWORD=
REALITY_EMAIL_FROM=Reality <access@example.com>
